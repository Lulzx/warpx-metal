+// Command-buffer completion handlers run asynchronously and may outlive the
+// queue that submitted them, so the sink is held by shared_ptr and captured by
+// value. Namespace scope (rather than nested in metal_inorder_queue) so the
+// submission helpers that install those handlers can name it.
+struct metal_async_error_state {
+  std::mutex mutex;
+  result error;
+};
+
+// Records the first asynchronous failure so that a later queue wait can fail
+// closed. Also forwards to register_error() for the global async error list.
+void record_metal_async_failure(
+    const std::shared_ptr<metal_async_error_state>& state, result failure);
