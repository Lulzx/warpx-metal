+// True if T is, or transitively contains, the LLVM `double` type. The Metal
+// emitter lowers `double` to VF64 software binary64 (see VF64Support.hpp) and
+// only inlines that support code when a module actually needs it.
+bool containsDoubleType(const llvm::Type* T, std::unordered_set<const llvm::Type*>& visited) {
+  if (!T || !visited.insert(T).second) return false;
+  if (T->isDoubleTy()) return true;
+  if (auto* AT = llvm::dyn_cast<llvm::ArrayType>(T)) return containsDoubleType(AT->getElementType(), visited);
+  if (auto* VT = llvm::dyn_cast<llvm::VectorType>(T)) return containsDoubleType(VT->getElementType(), visited);
+  if (auto* ST = llvm::dyn_cast<llvm::StructType>(T)) {
+    for (auto* E : ST->elements()) if (containsDoubleType(E, visited)) return true;
+  }
+  if (auto* FT = llvm::dyn_cast<llvm::FunctionType>(T)) {
+    if (containsDoubleType(FT->getReturnType(), visited)) return true;
+    for (auto* P : FT->params()) if (containsDoubleType(P, visited)) return true;
+  }
+  return false;
+}
+
+bool moduleUsesDouble(const llvm::Module& M) {
+  std::unordered_set<const llvm::Type*> visited;
+  for (const llvm::StructType* ST : const_cast<llvm::Module&>(M).getIdentifiedStructTypes())
+    if (containsDoubleType(ST, visited)) return true;
+  for (const llvm::GlobalVariable& GV : M.globals())
+    if (containsDoubleType(GV.getValueType(), visited)) return true;
+  for (const llvm::Function& F : M) {
+    if (containsDoubleType(F.getFunctionType(), visited)) return true;
+    for (const llvm::BasicBlock& BB : F)
+      for (const llvm::Instruction& I : BB) {
+        if (containsDoubleType(I.getType(), visited)) return true;
+        if (auto* AI = llvm::dyn_cast<llvm::AllocaInst>(&I))
+          if (containsDoubleType(AI->getAllocatedType(), visited)) return true;
+        for (const llvm::Value* Op : I.operands())
+          if (containsDoubleType(Op->getType(), visited)) return true;
+      }
+  }
+  return false;
+}
