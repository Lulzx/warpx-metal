+namespace {
+// Drop the libkernel bodies of f64 builtins that VF64 implements exactly. The
+// libkernel versions round through float; keeping them as declarations stops
+// the inliner from expanding them so the emitter can lower the call itself.
+void stripExactF64Builtins(llvm::Module& M) {
+  for (llvm::Function& F : M) {
+    if (F.isDeclaration()) continue;
+    if (!vf64ExactBuiltins().count(F.getName().str())) continue;
+    F.deleteBody();
+    F.removeFnAttr(llvm::Attribute::AlwaysInline);
+    F.setLinkage(llvm::GlobalValue::ExternalLinkage);
+  }
+}
+} // namespace
