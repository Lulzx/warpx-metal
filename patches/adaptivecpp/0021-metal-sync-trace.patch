+// TEMPORARY DIAGNOSTIC (ACPP_METAL_TRACE_SYNC=1).
+// Determines whether the CPU-listener -> GPU-wait cycle is reachable at all in
+// a real WarpX run. The cycle is bootstrapped exclusively by the host-to-host
+// memcpy branch, which is the only writer of _pending_cpu_event/_pending_gpu_event.
+// If h2h_listener stays 0, the cycle is unreachable and the remaining
+// notifyListener sites cannot explain a "scheduled forever, error == nil" hang.
+struct metal_sync_trace {
+  std::atomic<unsigned long long> h2h_total{0};      // host->host memcpy seen
+  std::atomic<unsigned long long> h2h_listener{0};   // ... took the listener branch (BOOTSTRAP)
+  std::atomic<unsigned long long> gpu_wait_armed{0}; // command buffer encoded a wait on _shared_event
+  std::atomic<unsigned long long> h2d_listener{0};   // H2D staging took the listener branch
+
+  static bool enabled() {
+    static const bool on = [] {
+      const char* e = std::getenv("ACPP_METAL_TRACE_SYNC");
+      return e && std::string{e} == "1";
+    }();
+    return on;
+  }
+
+  void bump(std::atomic<unsigned long long>& c, const char* what) {
+    if (!enabled()) return;
+    if (c.fetch_add(1) == 0) {
+      std::fprintf(stderr, "[acpp-metal-trace] FIRST %s\n", what);
+      std::fflush(stderr);
+    }
+  }
+
+  ~metal_sync_trace() {
+    if (!enabled()) return;
+    std::fprintf(stderr,
+                 "[acpp-metal-trace] h2h_total=%llu h2h_listener=%llu "
+                 "gpu_wait_armed=%llu h2d_listener=%llu\n",
+                 h2h_total.load(), h2h_listener.load(),
+                 gpu_wait_armed.load(), h2d_listener.load());
+    std::fflush(stderr);
+  }
+};
+
+metal_sync_trace g_metal_sync_trace;
+
 } // anonymous namespace
 
